# ────────────────────────────────────────────────────
# Alpha Quarante — Variables d'environnement
# ────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════
# EMAIL — OBLIGATOIRE pour envoyer les invitations
# ═══════════════════════════════════════════════════
# 1. Compte Gmail avec validation en 2 étapes activée
# 2. Créer un mot de passe d'application :
#    https://myaccount.google.com/apppasswords
# 3. Remplacer les valeurs ci-dessous (sans espaces dans le pass)

EMAIL_USER=ton.email@gmail.com
EMAIL_PASS=abcdefghijklmnop
EMAIL_FROM_NAME=ALPHA 40

# Lien Meet dans l'email d'invitation
INVITE_LINK=https://meet.google.com/eyy-bofp-zyb
EVENT_LINK=https://meet.google.com/eyy-bofp-zyb

# Token pour télécharger l'Excel : /api/admin/export.xlsx?token=...
ADMIN_TOKEN=change-moi

# Google Sheet (optionnel) — URL Apps Script, voir tools/google-apps-script.js
SHEETS_WEBHOOK_URL=

DB_PATH=./db/inscriptions.sqlite
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
